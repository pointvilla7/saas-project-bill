# ==============================================================================
# CHARGEAUDIT — PRODUCTION ENVIRONMENT VARIABLES (VERCEL DEPLOYMENT)
# ==============================================================================
# Copy these key-value pairs into your Vercel Project Settings -> Environment Variables.
# Ensure Production environment checkbox is selected for all live keys.

# ------------------------------------------------------------------------------
# 1. Supabase Credentials (Production Database & Auth)
# ------------------------------------------------------------------------------
# Production Supabase Project URL (Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://<your-prod-project-ref>.supabase.co

# Production Supabase Anon Key (Used for client-side queries with Row-Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Production Supabase Service Role Key (Server side ONLY: crons, webhooks, admin tasks)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Encryption passphrase for decrypting connected account API keys in PostgreSQL (pgcrypto)
SUPABASE_ENCRYPTION_KEY=chargeaudit_prod_secret_encryption_passphrase_32chars

# ------------------------------------------------------------------------------
# 2. Stripe Live API Credentials (Production SaaS Billing)
# ------------------------------------------------------------------------------
# Secret Stripe Live Key (sk_live_... from Stripe Dashboard -> API Keys)
STRIPE_SECRET_KEY=sk_live_51...

# Stripe Webhook Endpoint Secret (whsec_... from Stripe Dashboard -> Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_live_...

# Live Stripe Price IDs for Subscription Plans
STRIPE_STARTER_PRICE_ID=price_live_starter_12345
STRIPE_GROWTH_PRICE_ID=price_live_growth_12345
STRIPE_AGENCY_PRICE_ID=price_live_agency_12345

# ------------------------------------------------------------------------------
# 3. Resend Production Email Credentials
# ------------------------------------------------------------------------------
# Resend Production API Key (re_... from https://resend.com/api-keys)
RESEND_API_KEY=re_live_123456789

# Verified Sender Email Address (Domain must be verified in Resend Dashboard)
RESEND_FROM_EMAIL=alerts@chargeaudit.io

# ------------------------------------------------------------------------------
# 4. Vercel Cron Security & Authorization
# ------------------------------------------------------------------------------
# Secret 32+ character random string to protect /api/cron/* endpoints
# Vercel automatically passes this in the Authorization header: Bearer <CRON_SECRET>
CRON_SECRET=prod_cron_secret_key_8f3a9b2c1d4e7f6a0b9c8d7e6f5a4b3c

# Disable local dev preview bypass in production
PREVIEW_BYPASS=false

# ------------------------------------------------------------------------------
# 5. Sentry Production Error Monitoring (Free Tier)
# ------------------------------------------------------------------------------
# Sentry DSN (Sentry Dashboard -> Project Settings -> Client Keys DSN)
SENTRY_DSN=https://example123456@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://example123456@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# 6. Canonical Application URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://chargeaudit.io
