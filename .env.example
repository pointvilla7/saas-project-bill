# ==============================================================================
# CHARGEAUDIT — PRODUCTION & DEVELOPMENT ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Credentials (Database & Auth)
# ------------------------------------------------------------------------------
# Public Supabase URL (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon Key (used for client-side queries with Row-Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret Supabase Service Role Key (used ONLY for server-side admin jobs, webhooks & crons)
# CAUTION: Never expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Stripe Billing Integration Credentials (SaaS Pricing & Checkout)
# ------------------------------------------------------------------------------
# Secret Stripe API Key (sk_live_... for Production, sk_test_... for Development)
STRIPE_SECRET_KEY=sk_test_51...

# Stripe Webhook Signing Secret (whsec_... from Stripe Dashboard -> Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs for ChargeAudit Subscription Plans
STRIPE_STARTER_PRICE_ID=price_starter_12345
STRIPE_GROWTH_PRICE_ID=price_growth_12345
STRIPE_AGENCY_PRICE_ID=price_agency_12345

# ------------------------------------------------------------------------------
# 3. Resend Email Delivery API
# ------------------------------------------------------------------------------
# Resend API Key (re_... from https://resend.com/api-keys)
RESEND_API_KEY=re_123456789

# Verified Sender Email Address
RESEND_FROM_EMAIL=alerts@chargeaudit.io

# ------------------------------------------------------------------------------
# 4. Cron Security & Automation
# ------------------------------------------------------------------------------
# Secret token to protect /api/cron/* endpoints against unauthorized requests
CRON_SECRET=your-random-32-char-cron-secret-here

# Optional: Bypass auth check for local development & browser screenshot previews
PREVIEW_BYPASS=false

# ------------------------------------------------------------------------------
# 5. Sentry Error Monitoring (Optional Free Tier)
# ------------------------------------------------------------------------------
# Sentry DSN for server-side and client-side error reporting
SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@o0.ingest.sentry.io/0

# ------------------------------------------------------------------------------
# 6. Application Base URL
# ------------------------------------------------------------------------------
# Base URL of the deployed application (used for canonical tags, webhooks & redirects)
NEXT_PUBLIC_APP_URL=https://chargeaudit.io
